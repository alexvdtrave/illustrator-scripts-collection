{
  "name": "illustrator-stock-scripts",
  "version": "1.2.0",
  "description": "A collection of scripts for Adobe Illustrator",
  "author": "alexvdtrave",
  "homepage": "https://github.com/alexvdtrave/illustrator-scripts-collection",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexvdtrave/illustrator-scripts-collection.git"
  },
  "bugs": {
    "url": "https://github.com/alexvdtrave/illustrator-scripts-collection/issues"
  },
  "keywords": [
    "illustrator"
  ],
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "lint": "eslint \"src/**/*.js\" --fix",
    "test": "node -r @babel/register --test test/*.test.js",
    "copy": "cp dist/*.jsx /Applications/Adobe\\ Illustrator\\ 2020/Presets.localized/en_US/Scripts"
  },
  "license": "MIT",
  "devDependencies": {
    "@ampproject/rollup-plugin-closure-compiler": "^0.27.0",
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/register": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "rollup": "^4.66.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
